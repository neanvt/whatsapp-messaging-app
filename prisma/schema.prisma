generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  companyName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  role          String    @default("admin") // admin | superadmin

  whatsappNumbers WhatsAppNumber[]
  templates      Template[]
  messages       Message[]
  payments       Payment[]
  credits        UserCredits?
  auditLogs      AuditLog[]
  conversations  Conversation[]
  tenantMetaApp  TenantMetaApp?
  apiKeys        ApiKey[]
}

model TenantMetaApp {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaAppId     String   // plaintext — Meta App ID is not a secret
  metaAppSecret String   // AES-256-GCM ciphertext at rest — never plaintext, never logged, never returned
  configId      String?  // optional Embedded Signup Configuration ID — not a secret
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserCredits {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalCredits    Int       @default(0)
  usedCredits     Int       @default(0)
  lastRechargedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model WhatsAppNumber {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber           String    @unique
  wabaId                String?
  phoneNumberId         String?
  verificationStatus     String    @default("pending") // pending, in_progress, verified, failed
  verificationCode      String?
  verifiedAt            DateTime?
  accessToken           String?   // AES-256-GCM ciphertext at rest — never stored plaintext, never logged
  tokenExpiresAt        DateTime?
  displayPhoneNumber    String?
  verifiedName          String?
  qualityRating         String?
  codeVerificationStatus String?
  platformType          String?
  connectionType        String    @default("manual")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  templates     Template[]
  messages      Message[]
  conversations Conversation[]
  apiKeys       ApiKey[]
}

model Template {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumberId String?
  whatsappNumber  WhatsAppNumber? @relation(fields: [whatsappNumberId], references: [id])

  name           String
  category       String    // marketing, utility, authentication
  language       String    @default("en")
  body           String
  headerType     String?   // none, text, image, video, document
  headerContent  String?
  footerContent  String?
  buttons        String?     // Array of button objects (stored as JSON string)
  mediaAttachments String?  // Array of media attachment objects (stored as JSON string)
  status         String    @default("draft") // draft, pending, submitted, approved, rejected
  rejectionReason String?
  metaTemplateId  String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages Message[]
}

model Message {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumberId     String
  whatsappNumber      WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id])
  templateId          String?
  template            Template? @relation(fields: [templateId], references: [id])

  metaMessageId   String?
  recipientPhone  String
  templateVariables String?    // Array of variable values (stored as JSON string)
  status          String    @default("queued") // queued, sent, delivered, read, failed, received
  errorMessage    String?
  direction       String    @default("outbound") // outbound | inbound
  content         String?   // raw text for free-text or inbound messages
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
}

model Conversation {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumberId   String
  whatsappNumber     WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id])
  contactPhone       String
  contactName        String?
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages           Message[]

  @@unique([whatsappNumberId, contactPhone])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  razorpayPaymentId   String?
  razorpayOrderId     String    @unique
  razorpayInvoiceId   String?
  razorpaySignature   String?

  amount          Int       // In paise
  amountInr       Float
  currency        String    @default("INR")

  creditsPurchased Int
  creditsUsed     Int       @default(0)
  creditsRemaining Int      @default(0)

  status          String    @default("pending") // pending, processing, completed, failed, refunded
  paymentMethod   String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
}

model Package {
  id           String   @id @default(cuid())
  planId       String   @unique
  name         String
  credits      Int
  priceInr     Int
  priceInPaise Int
  pricePerMsg  Float
  isActive     Boolean  @default(true)
  isPopular    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiKey {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumberId String
  whatsappNumber   WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)
  name             String?        // tenant-chosen display label
  keyPrefix        String         // non-secret display fragment, e.g. "wa_live_ab12"
  keyHash          String         @unique // SHA-256 hex of the full key; never plaintext
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
}
