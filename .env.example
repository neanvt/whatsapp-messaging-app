# ---------------------------------------------------------------------------
# Example environment configuration — PLACEHOLDERS ONLY. Never commit real
# secrets. Copy to `.env` and fill in actual values locally.
# ---------------------------------------------------------------------------

# --- Database (Turso / libSQL) ---------------------------------------------
# Prisma datasource points at Turso over the libSQL driver adapter (SQLite).
# There is NO Postgres DATABASE_URL anymore.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- NextAuth ---------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_JWT_SECRET="your-nextauth-jwt-secret"

# --- Meta WhatsApp Business API ---------------------------------------------
# META_APP_ID / META_APP_SECRET identify the Meta app. META_APP_SECRET is also
# used to verify inbound webhook payloads (X-Hub-Signature-256) and to exchange
# the Embedded Signup OAuth code — it is MANDATORY for delivery-status updates.
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Legacy / global fallback credentials. Used by resolveSendCredentials() only
# when a WhatsAppNumber row has no stored per-tenant token. Per-tenant tokens
# captured via Embedded Signup / manual connect take precedence.
META_ACCESS_TOKEN="your-meta-access-token"
META_PHONE_NUMBER_ID="your-meta-phone-number-id"

# WhatsApp Business Account ID (optional global reference).
META_WABA_ID="your-meta-waba-id"

# Token the Meta webhook GET handshake must echo (hub.verify_token).
META_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# --- Client-exposed Meta values (build-time inlined) ------------------------
# NEXT_PUBLIC_* vars are inlined into the client bundle by Next at BUILD time.
# Changing them requires a REBUILD to take effect — a running server will not
# pick up new values. There is NO server-side META_CONFIG_ID; the Embedded
# Signup Configuration ID is only ever read client-side via NEXT_PUBLIC_META_CONFIG_ID.
NEXT_PUBLIC_META_APP_ID="your-meta-app-id"
NEXT_PUBLIC_META_CONFIG_ID="your-embedded-signup-configuration-id"

# --- Token encryption -------------------------------------------------------
# AES-256-GCM key: 32 raw bytes, base64-encoded. Per-tenant access tokens are
# encrypted at rest with this key. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY="your-base64-32-byte-key"

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---------------------------------------------------------------------------
# Meta-side prerequisites (configured in your Meta app — NOT in code):
#   * Configure the app for WhatsApp Embedded Signup and create a
#     Configuration ID. The code reads it client-side as
#     NEXT_PUBLIC_META_CONFIG_ID; changing it requires a rebuild.
#   * Submit for App Review and obtain approval for the permissions
#     whatsapp_business_management and whatsapp_business_messaging.
#   * META_APP_SECRET is mandatory: without it the webhook rejects every
#     payload (401), so delivery-status updates never land.
# ---------------------------------------------------------------------------
