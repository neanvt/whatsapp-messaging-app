# ---------------------------------------------------------------------------
# Example environment configuration — PLACEHOLDERS ONLY. Never commit real
# secrets. Copy to `.env` and fill in actual values locally.
# ---------------------------------------------------------------------------

# --- Database (Turso / libSQL) ---------------------------------------------
# Prisma datasource points at Turso over the libSQL driver adapter (SQLite).
# There is NO Postgres DATABASE_URL anymore.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- NextAuth ---------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_JWT_SECRET="your-nextauth-jwt-secret"

# --- Meta WhatsApp Business API (PLATFORM / MODEL A FALLBACK) ---------------
# These identify the PLATFORM Meta app and the single webhook. They are the
# Model A fallback: used for a tenant's OAuth code exchange and inbound-webhook
# signature verification ONLY WHEN that tenant has not connected their own Meta
# app (Model B) via Settings. A tenant with their own app uses theirs instead
# (per-tenant app credentials live encrypted in the DB — TenantMetaApp — not here).
#
# Per-tenant number values (access token, phone number id, WABA id) are also NOT
# configured here: each connected WhatsAppNumber stores its own encrypted token +
# phone number id + WABA id in the database, captured via Embedded Signup or the
# manual connect path. There is no env fallback for sends — a number with no
# stored credentials cannot send until it is (re)connected.
#
# META_APP_ID / META_APP_SECRET identify the platform Meta app that tenants
# connect through by default. META_APP_SECRET exchanges the Embedded Signup
# OAuth code and verifies inbound webhook payloads (X-Hub-Signature-256) for
# platform-app (Model A) tenants.
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Token the shared Meta webhook GET handshake must echo (hub.verify_token).
# This stays PLATFORM-LEVEL and SHARED: the GET handshake and the single webhook
# endpoint are not per-tenant (out of scope). Only POST signature verification
# becomes per-app (Model B tenants verify against their own app secret).
META_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# --- Client-exposed Meta values (platform / Model A fallback) ---------------
# NEXT_PUBLIC_META_APP_ID / NEXT_PUBLIC_META_CONFIG_ID remain the platform
# (Model A) fallback that drives the connect page's Embedded Signup. The connect
# page now fetches the EFFECTIVE app/config at runtime from GET /api/meta-app, so
# a tenant's own app (Model B) overrides these without a rebuild.
#
# NEXT_PUBLIC_META_CONFIG_ID is the platform (Model A) Embedded Signup
# Configuration ID. It is inlined into the client bundle at build time AND read
# server-side by resolveMetaAppCredentials and GET /api/meta-app as a plain env
# var (the NEXT_PUBLIC_ prefix does not stop server reads). The connect page now
# obtains the effective config id at runtime from GET /api/meta-app, so a
# tenant's own Config ID (Model B, stored encrypted in the DB) overrides this
# platform value without a rebuild.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so any
# code that reads the inlined constant directly still needs a rebuild to pick up
# a new value. The connect page no longer reads those constants directly — it
# fetches the effective app/config at runtime from GET /api/meta-app — so
# changing a tenant's own app via Settings takes effect without a rebuild.
# Changing the platform fallback values themselves still requires updating the
# env and (for any remaining inlined client reads) a rebuild.
NEXT_PUBLIC_META_APP_ID="your-meta-app-id"
NEXT_PUBLIC_META_CONFIG_ID="your-embedded-signup-configuration-id"

# --- Token encryption -------------------------------------------------------
# AES-256-GCM key: 32 raw bytes, base64-encoded. Per-tenant access tokens are
# encrypted at rest with this key. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY="your-base64-32-byte-key"

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---------------------------------------------------------------------------
# Meta-side prerequisites (configured in your Meta app — NOT in code). These
# apply PER APP: once for the platform app, and once per tenant that brings
# their own Meta app (Model B):
#   * Configure the app for WhatsApp Embedded Signup and create a
#     Configuration ID. The platform Configuration ID is set as
#     NEXT_PUBLIC_META_CONFIG_ID; it is read both in the client bundle and
#     server-side, and the connect page fetches the effective (tenant-or-
#     platform) value at runtime, so a tenant's own Configuration ID overrides
#     the platform one without a rebuild.
#   * Submit for App Review and obtain approval for the permissions
#     whatsapp_business_management and whatsapp_business_messaging.
#   * META_APP_SECRET verifies inbound webhooks for tenants on the platform app
#     (Model A); tenants who connected their own Meta app (Model B) are verified
#     against their own secret instead. Keep it set — without it, platform-app
#     tenants' delivery-status updates are rejected (401).
# ---------------------------------------------------------------------------
